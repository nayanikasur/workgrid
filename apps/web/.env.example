# Development needs neither: Vite proxies /api and /socket.io to the API on :4000.

# Origin for REST calls. Leave blank when the web host proxies /api to the API
# (see apps/web/vercel.json), which keeps the refresh cookie first-party.
VITE_API_URL=

# Origin for the Socket.IO connection, e.g. https://workgrid-api.onrender.com
# Required in production because static hosts cannot proxy WebSockets.
VITE_SOCKET_URL=
