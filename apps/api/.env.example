# Copy to .env — every value below works for local development as-is.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/workgrid
CLIENT_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-in-production

# Refresh-cookie SameSite. Keep `lax` when the web host proxies /api (see README);
# set `none` only if the browser calls this API cross-site directly.
COOKIE_SAMESITE=lax

# Optional — Stripe test mode. Billing UI shows "not configured" when blank.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
